# ===== 多Agent客诉舆情退赔决策系统 配置示例（复制为 .env 后填入真实值）=====

# MySQL（裁决 D3：MySQL 8.0）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=complaint_refund

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（生产环境必须更换为随机长字符串）
JWT_SECRET=dev-only-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# LLM（裁决 D2：云 API 主 + Ollama 回退；key 请填入真实值，禁止提交到 git）
LLM_API_BASE=https://api.agicto.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=10.0
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_FALLBACK_MODEL=qwen2:7b

# 业务阈值默认值（运行期以 system_configs 表为准）
AMOUNT_THRESHOLD=300.0
FRAUD_SUSPEND_THRESHOLD=60
FRAUD_AUTO_PASS_THRESHOLD=20
OCR_CONFIDENCE_THRESHOLD=0.6

# 上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
